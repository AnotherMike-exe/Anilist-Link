# Anilist-Link Local Development Environment
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Values set here override code defaults but are overridden by
# settings saved in the web UI (stored in ./data/anilist_link.db).
# Priority: env var > DB setting > code default

# --- General ---
DEBUG=true
TZ=America/New_York

# --- AniList OAuth2 ---
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# --- Crunchyroll ---
CRUNCHYROLL_EMAIL=
CRUNCHYROLL_PASSWORD=
FLARESOLVERR_URL=
HEADLESS_MODE=true
MAX_PAGES=10

# --- Plex ---
PLEX_URL=
PLEX_TOKEN=
PLEX_ANIME_LIBRARIES=[]

# --- Jellyfin ---
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- Sonarr / Radarr ---
SONARR_URL=
SONARR_API_KEY=
# Where new anime series are added, as Sonarr sees it
SONARR_ANIME_ROOT_FOLDER=
# Only needed when Sonarr and Anilist-Link see the same files at different
# paths (separate containers, different volume mounts). Give the same
# directory as each one sees it; leave both blank if the paths already match.
SONARR_PATH_PREFIX=
SONARR_LOCAL_PATH_PREFIX=

RADARR_URL=
RADARR_API_KEY=
RADARR_ANIME_ROOT_FOLDER=
RADARR_PATH_PREFIX=
RADARR_LOCAL_PATH_PREFIX=

# --- Library layout ---
# Where restructured/imported media is written. Paths are as Anilist-Link
# sees them inside the container — see the volume mappings in
# docker-compose.yml.
LIBRARY_TV_OUTPUT_PATH=/media/anime
# Set true to file movies separately from TV
LIBRARY_SPLIT_MOVIES_TV=false
LIBRARY_MOVIE_OUTPUT_PATH=
# Drop media you fetched by hand here; review and import it at /import.
# Needs its own volume mapping in docker-compose.yml.
LIBRARY_IMPORT_PATH=/media/import

# --- Webhooks ---
# Must be reachable by Sonarr/Radarr, so not localhost when they run elsewhere
APP_BASE_URL=http://localhost:9876

# --- Scheduler ---
SCAN_INTERVAL=24
SYNC_INTERVAL=15
